# ============================================================
# Laravel - .htaccess en la raíz del proyecto (XAMPP subcarpeta)
# ============================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. BLOQUEAR ARCHIVOS Y DIRECTORIOS SENSIBLES
    RewriteRule ^\.env(?:\..*)?$ - [F,L,NC]
    RewriteRule ^\.git(?:/|$) - [F,L,NC]
    RewriteRule ^composer\.(json|lock)$ - [F,L,NC]
    RewriteRule ^artisan$ - [F,L,NC]
    RewriteRule ^\.htaccess$ - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests|vendor)(?:/|$) - [F,L,NC]

    # Proteger almacenamiento interno que no debe ser público
    RewriteRule ^storage/(app|framework|logs)(?:/|$) - [F,L,NC]

    # 2. BLOQUEAR ARCHIVOS OCULTOS
    RewriteRule (^|/)\. - [F,L,NC]

    # 3. REESCRITURA A PUBLIC
    RewriteBase /cauchos-alfa/
    RewriteCond %{REQUEST_URI} !^/cauchos-alfa/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Bloqueo adicional de archivos sensibles
<FilesMatch "^(\.env|\.env\..*|composer\.(json|lock)|artisan|phpunit\.xml|\.gitignore|\.gitattributes)$">
    Require all denied
</FilesMatch>

# Proteger archivos de configuración y backups
<FilesMatch "\.(bak|config|dist|fla|inc|ini|log|old|orig|sh|sql|swp|tmp|tpl|yml|yaml)$">
    Require all denied
</FilesMatch>

Options -Indexes
