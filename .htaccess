<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # 1. Seguridad: Bloqueos directos
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule (^|/)\. - [F,L,NC]
    RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|server\.php|artisan)$ - [F,L,NC]
    # NOTA: No bloqueamos 'storage' aqui porque las imagenes publicas viajan por /storage/
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests|vendor)(/.*)?$ - [F,L,NC]

    # 2. Enrutamiento
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "\.(log|sql|bak|yml|yaml|ini|sh|sqlite)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
